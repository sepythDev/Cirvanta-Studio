<Window x:Class="CircuitForge.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CircuitForge" Height="740" Width="1260" MinHeight="540" MinWidth="900"
 Background="#F3F6FA" Foreground="#172033" WindowStartupLocation="CenterScreen"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowState="Normal"
 PreviewKeyDown="Window_PreviewKeyDown">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="52"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="26"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#D9E1EC" BorderThickness="0,0,0,1">
   <DockPanel Margin="16,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="CIRCUIT" FontSize="18" FontWeight="Bold" Foreground="#172033"/>
     <TextBlock Text="FORGE" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
     <TextBlock Text="  /  SCHEMATIC EDITOR" Margin="14,3,0,0" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button Content="Новый" Click="New_Click" Margin="3,0" Padding="10,5"/>
     <Button Content="Открыть" Click="Open_Click" Margin="3,0" Padding="10,5"/>
     <Button Content="Сохранить" Click="Save_Click" Margin="3,0" Padding="10,5"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="White" BorderBrush="#D9E1EC" BorderThickness="0,0,0,1" Padding="9,6">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="КОМПОНЕНТЫ И ИНСТРУМЕНТЫ  ·  Выбери элемент, наведи на поле и кликни для размещения" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,6"/>
    <WrapPanel Grid.Row="1" Margin="0,0,0,5" VerticalAlignment="Center">
     <!-- 1. Электропитание -->
     <Button Click="CategoryPower_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Электропитание" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Path Width="22" Height="22" Data="M 14,0 L 5,12 L 11,12 L 8,22 L 19,8 L 13,8 Z" Fill="Black" Stretch="Uniform">
       <Path.RenderTransform>
        <TranslateTransform X="3"/>
       </Path.RenderTransform>
      </Path>
     </Button>
     <!-- 2. Автоматы -->
     <Button Click="CategoryBreakers_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Автоматы" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Rectangle Canvas.Left="5" Canvas.Top="0" Width="12" Height="22" RadiusX="2.5" RadiusY="2.5" Fill="White" Stroke="Black" StrokeThickness="1.2"/>
       <Ellipse Canvas.Left="9" Canvas.Top="2" Width="4" Height="4" Fill="White" Stroke="Black" StrokeThickness="1.0"/>
       <Ellipse Canvas.Left="10.2" Canvas.Top="3.2" Width="1.6" Height="1.6" Fill="Black"/>
       <Rectangle Canvas.Left="2" Canvas.Top="5.5" Width="18" Height="12" RadiusX="2" RadiusY="2" Fill="White" Stroke="Black" StrokeThickness="1.2"/>
       <Rectangle Canvas.Left="5" Canvas.Top="9.5" Width="12" Height="7" RadiusX="1.6" RadiusY="1.6" Fill="Black"/>
       <Rectangle Canvas.Left="7" Canvas.Top="10.8" Width="8" Height="5" Fill="White" Stroke="Black" StrokeThickness="0.8"/>
       <Line X1="8.4" Y1="14.5" X2="13.6" Y2="14.5" Stroke="Black" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Ellipse Canvas.Left="9" Canvas.Top="18" Width="4" Height="4" Fill="White" Stroke="Black" StrokeThickness="1.0"/>
       <Ellipse Canvas.Left="10.2" Canvas.Top="19.2" Width="1.6" Height="1.6" Fill="Black"/>
      </Canvas>
     </Button>
     <!-- 3. Контакторы и переключатели -->
     <Button Click="CategoryContactors_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Контакторы и переключатели" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Line X1="1" Y1="11" X2="5" Y2="11" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="5" Y1="5" X2="5" Y2="17" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="17" Y1="5" X2="17" Y2="17" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="5" Y1="7" X2="17" Y2="15" Stroke="#2563EB" StrokeThickness="1.4"/>
       <Line X1="17" Y1="11" X2="21" Y2="11" Stroke="#334155" StrokeThickness="1.4"/>
      </Canvas>
     </Button>
     <!-- 4. Моторы -->
     <Button Click="CategoryMotors_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Моторы" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Ellipse Canvas.Left="2" Canvas.Top="2" Width="18" Height="18" Stroke="#334155" StrokeThickness="1.8"/>
       <TextBlock Canvas.Left="6" Canvas.Top="4" Text="M" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
      </Canvas>
     </Button>
     <!-- 7. Кнопки -->
     <Button Click="CategoryButtons_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Кнопки" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Line X1="11" Y1="1" X2="11" Y2="7" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="11" Y1="16" X2="11" Y2="21" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="11" Y1="7" X2="6" Y2="11" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="6" Y1="11" X2="11" Y2="16" Stroke="#334155" StrokeThickness="1.4"/>
       <Line X1="2" Y1="11" X2="7" Y2="11" Stroke="#64748B" StrokeThickness="1.4" StrokeDashArray="1.5,1.5"/>
      </Canvas>
     </Button>
     <!-- 9. Катушки -->
     <Button Click="CategoryCoils_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Катушки" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Line X1="2" Y1="11" X2="5" Y2="11" Stroke="#334155" StrokeThickness="1.8"/>
       <Path Data="M 5,4 C 9,4 9,18 13,18 C 17,18 17,4 21,4" Stroke="#334155" StrokeThickness="1.8" Fill="Transparent"/>
       <Line X1="21" Y1="11" X2="22" Y2="11" Stroke="#334155" StrokeThickness="1.8"/>
      </Canvas>
     </Button>
     <!-- 10. Реле -->
     <Button Click="CategoryRelays_Click" Margin="2" Padding="5" Width="34" Height="32"
             ToolTip="Реле" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="8000"
             Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
      <Canvas Width="22" Height="22">
       <Rectangle Canvas.Left="3" Canvas.Top="3" Width="16" Height="16" Stroke="#334155" StrokeThickness="1.8"/>
       <TextBlock Canvas.Left="7" Canvas.Top="4" Text="K" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"/>
      </Canvas>
     </Button>
    </WrapPanel>
    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="94">
      <WrapPanel x:Name="PalettePanel"/>
     </ScrollViewer>
     <Border Grid.Column="1" Background="#D9E1EC" Margin="7,2"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
      <Button Content="↻ Поворот" Click="RotateSelected_Click" Padding="9,8" Margin="2,0" ToolTip="Повернуть выбранный элемент на 90° (R)"/>
      <Button x:Name="RunButton" Content="▶ Запуск" Click="Run_Click" Padding="10,8" Margin="2,0" Background="#2563EB" Foreground="White"/>
      <Button x:Name="StopButton" Content="■ Стоп" Click="Stop_Click" Padding="10,8" Margin="2,0" IsEnabled="False"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>

  <Border Grid.Row="2" Margin="10" BorderBrush="#D6DEE9" BorderThickness="1" CornerRadius="7" Background="White" ClipToBounds="True">
   <Grid Background="White">
    <Canvas x:Name="SchematicCanvas" Width="3000" Height="2000"
      HorizontalAlignment="Left" VerticalAlignment="Top" Background="White"
      MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
      MouseMove="Canvas_MouseMove"
      MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
      MouseRightButtonDown="Canvas_MouseRightButtonDown"
      MouseLeave="Canvas_MouseLeave"
      Focusable="True" KeyDown="Canvas_KeyDown"/>
    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="8,5" CornerRadius="4" Background="#F1F5F9" IsHitTestVisible="False">
     <TextBlock Text="РАБОЧЕЕ ПОЛЕ" FontSize="10" Foreground="#64748B"/>
    </Border>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="8,5" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" IsHitTestVisible="False">
     <TextBlock Text="Провод: клемма → клемма · R — поворот · Backspace — удалить · Esc — отменить" FontSize="9" Foreground="#64748B"/>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Row="3" Background="White" BorderBrush="#D9E1EC" BorderThickness="0,1,0,0" Padding="10,3">
   <DockPanel>
    <TextBlock x:Name="StatusText" Text="Готово. Выбери компонент в панели сверху." Foreground="#64748B" FontSize="10"/>
    <TextBlock DockPanel.Dock="Right" Text="MVP 0.5.0" Foreground="#94A3B8" FontSize="10"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
