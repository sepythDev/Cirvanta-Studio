<Window x:Class="CircuitForge.MainWindow"
 xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cirvanta Studio" Height="740" Width="1260" MinHeight="540" MinWidth="900"
 Icon="/Assets/cirvanta.ico"
 Background="#F3F6FA" Foreground="#172033" FontSize="12"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="ToolBtnBg">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="ToolBtnHoverBg">#EFF6FF</SolidColorBrush>
  <SolidColorBrush x:Key="ToolBtnBorder">#CBD5E1</SolidColorBrush>
  <SolidColorBrush x:Key="ToolBtnHoverBorder">#60A5FA</SolidColorBrush>
 </Window.Resources>

 <Window.Styles>
  <!-- WPF default control font is 12px; Fluent defaults to 14px. -->
  <Style Selector="Button">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 <Style Selector="Button.cat">
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Padding" Value="5"/>
   <Setter Property="Width" Value="34"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.cat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
  </Style>

  <Style Selector="Button.pal">
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.pal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
  </Style>

  <Style Selector="Button.tool">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
  </Style>

  <!-- Запуск: обычное состояние, наведение и нажатие -->
  <Style Selector="Button.runButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#2563EB"/>
  </Style>
  <Style Selector="Button.runButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2563EB"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#2563EB"/>
  </Style>

  <!-- Стоп: обычное состояние, наведение и нажатие -->
  <Style Selector="Button.stopButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DC2626"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#DC2626"/>
  </Style>
  <Style Selector="Button.stopButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DC2626"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#DC2626"/>
  </Style>
 </Window.Styles>

 <Grid>
  <Grid.RowDefinitions>
   <!-- 0: Верхняя панель (меню и кнопки запуска) -->
   <RowDefinition Height="37"/>
   <!-- 1: Панель инструментов (категории) -->
   <RowDefinition Height="Auto"/>
   <!-- 2: Панель вкладок (строго по высоте вкладок) -->
   <RowDefinition Height="Auto"/>
   <!-- 3: Рабочее поле (растягивается на ВСЮ оставшуюся высоту!) -->
   <RowDefinition Height="*"/>
   <!-- 4: Нижний статус-бар -->
   <RowDefinition Height="26"/>
  </Grid.RowDefinitions>

  <!-- 0. ВЕРХНЯЯ СТРОКА: меню слева, запуск/тема/язык справа -->
  <Border x:Name="TopBar" Grid.Row="0" Background="White" BorderBrush="#D9E1EC" BorderThickness="0,0,0,1">
    <Grid Margin="8,0">
      <!-- Левая часть: кнопка Файл + быстрые инструменты -->
      <!-- Левая часть: кнопка Файл -->
      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FileMenuButton"
                Content="Файл"
                Click="FileMenu_Click"
                Padding="9,3"
                FontSize="13.2"
                Background="Transparent"
                BorderThickness="0"/>
      </StackPanel>

      <!-- Правая часть: прижата строго в правый край -->
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
        <Button x:Name="ThemeToggleButton"
                Click="ThemeToggle_Click"
                Width="30" Height="28" Padding="0"
                Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="5"
                ToolTip.Tip="Тема">
          <TextBlock x:Name="ThemeIconText" Text="☾" FontFamily="Segoe UI Symbol" FontSize="18"
                     Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Button x:Name="LanguageButton"
                Width="30" Height="28" Margin="5,0,0,0" Padding="0"
                Background="#FFFFFF" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="5"
                FontSize="10" FontWeight="SemiBold"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Content="RU" ToolTip.Tip="Язык">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="RU" Click="LanguageRu_Click"/>
              <MenuItem Header="EN" Click="LanguageEn_Click"/>
              <MenuItem Header="ES" Click="LanguageEs_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button x:Name="RunButton"
                Classes="runButton"
                Content="▶ Запуск"
                Click="Run_Click"
                Cursor="Hand"
                Padding="10,5"
                Background="#2563EB"
                Foreground="White"
                BorderBrush="#2563EB"
                BorderThickness="1"
                CornerRadius="5"/>

        <Button x:Name="StopButton"
                Classes="stopButton"
                Content="■ Стоп"
                Click="Stop_Click"
                Cursor="Hand"
                Padding="10,5"
                Background="#DC2626"
                Foreground="White"
                BorderBrush="#DC2626"
                BorderThickness="1"
                CornerRadius="5"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- 1. ПАНЕЛЬ ИНСТРУМЕНТОВ (Категории и палитра) -->
  <!-- 1. ПАНЕЛЬ ИНСТРУМЕНТОВ (Категории и палитра) -->
  <Border x:Name="ToolboxBorder" Grid.Row="1" VerticalAlignment="Bottom" Background="White" BorderBrush="#D9E1EC" BorderThickness="0" Padding="9,2,9,6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Панель категорий кнопок -->
      <WrapPanel x:Name="CategoryPanel" Grid.Row="0" Margin="0,0,0,5" VerticalAlignment="Center">
        <!-- 1. Электропитание -->
        <Button Classes="cat" Click="CategoryPower_Click" ToolTip.Tip="Электропитание" ToolTip.ShowDelay="350">
          <Path Width="22" Height="22" Data="M 14,0 L 5,12 L 11,12 L 8,22 L 19,8 L 13,8 Z" Fill="Black" Stretch="Uniform">
            <Path.RenderTransform>
              <TranslateTransform X="3"/>
            </Path.RenderTransform>
          </Path>
        </Button>
        <!-- 2. Автоматы -->
        <Button Classes="cat" Click="CategoryBreakers_Click" ToolTip.Tip="Автоматы" ToolTip.ShowDelay="350">
          <Canvas Width="22" Height="22">
            <Rectangle Canvas.Left="5" Canvas.Top="0.5" Width="12" Height="21" RadiusX="1.8" RadiusY="1.8" Fill="White" Stroke="Black" StrokeThickness="1.2"/>
            <Ellipse Canvas.Left="7.0" Canvas.Top="1.8" Width="2.4" Height="2.4" Fill="Black"/>
            <Ellipse Canvas.Left="12.6" Canvas.Top="1.8" Width="2.4" Height="2.4" Fill="Black"/>
            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="16" Height="12" RadiusX="1.8" RadiusY="1.8" Fill="White" Stroke="Black" StrokeThickness="1.3"/>
            <Rectangle Canvas.Left="6.8" Canvas.Top="7.5" Width="3.2" Height="5" RadiusX="0.8" RadiusY="0.8" Fill="Black"/>
            <Rectangle Canvas.Left="12.6" Canvas.Top="7.5" Width="3.2" Height="5" RadiusX="0.8" RadiusY="0.8" Fill="Black"/>
            <Rectangle Canvas.Left="5.8" Canvas.Top="11.8" Width="11" Height="2.8" RadiusX="1.1" RadiusY="1.1" Fill="Black"/>
            <Ellipse Canvas.Left="7.0" Canvas.Top="17.7" Width="2.4" Height="2.4" Fill="Black"/>
            <Ellipse Canvas.Left="12.6" Canvas.Top="17.7" Width="2.4" Height="2.4" Fill="Black"/>
          </Canvas>
        </Button>
        <!-- 3. Контакторы и переключатели -->
        <Button Classes="cat" Click="CategoryContactors_Click" ToolTip.Tip="Контакторы и переключатели" ToolTip.ShowDelay="350">
          <Canvas Width="22" Height="22">
            <Line StartPoint="0,11" EndPoint="5,11" Stroke="Black" StrokeThickness="1.4"/>
            <Ellipse Canvas.Left="5" Canvas.Top="9" Width="4" Height="4" Fill="Black"/>
            <Ellipse Canvas.Left="16" Canvas.Top="9" Width="4" Height="4" Fill="Black"/>
            <Line StartPoint="7,10" EndPoint="20,2" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="18,11" EndPoint="23,11" Stroke="Black" StrokeThickness="1.4"/>
          </Canvas>
        </Button>
        <!-- 4. Моторы -->
        <Button Classes="cat" Click="CategoryMotors_Click" ToolTip.Tip="Моторы" ToolTip.ShowDelay="350">
          <Canvas Width="22" Height="22">
            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="18" Height="18" Stroke="Black" StrokeThickness="1.7"/>
            <TextBlock Canvas.Left="5.3" Canvas.Top="3" Width="10" Height="16" Text="M" Foreground="Black" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
          </Canvas>
        </Button>
        <!-- 7. Кнопки -->
        <Button Classes="cat" Click="CategoryButtons_Click" ToolTip.Tip="Кнопки" ToolTip.ShowDelay="350">
          <Canvas Width="22" Height="22" RenderTransformOrigin="50%,50%">
            <Canvas.RenderTransform>
              <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
            </Canvas.RenderTransform>
            <Line StartPoint="11,0.5" EndPoint="11,6" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="7,3" EndPoint="11,7" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="11,7" EndPoint="15,3" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="4,8.5" EndPoint="18,8.5" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="6,12" EndPoint="10,12" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="12,12" EndPoint="16,12" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="6,12" EndPoint="6,18" Stroke="Black" StrokeThickness="1.4"/>
            <Line StartPoint="16,12" EndPoint="16,18" Stroke="Black" StrokeThickness="1.4"/>
            <Ellipse Canvas.Left="4" Canvas.Top="17" Width="4" Height="4" Stroke="Black" StrokeThickness="1.4" Fill="White"/>
            <Ellipse Canvas.Left="14" Canvas.Top="17" Width="4" Height="4" Stroke="Black" StrokeThickness="1.4" Fill="White"/>
            <Ellipse Canvas.Left="5.3" Canvas.Top="18.3" Width="1.4" Height="1.4" Fill="White"/>
            <Ellipse Canvas.Left="15.3" Canvas.Top="18.3" Width="1.4" Height="1.4" Fill="White"/>
          </Canvas>
        </Button>
        <!-- 9. Катушки -->
        <Button Classes="cat" Click="CategoryCoils_Click" ToolTip.Tip="Катушки" ToolTip.ShowDelay="350">
          <Canvas Width="22" Height="22" RenderTransformOrigin="50%,50%">
            <Canvas.RenderTransform>
              <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
            </Canvas.RenderTransform>
            <Line StartPoint="11,0.5" EndPoint="11,6" Stroke="Black" StrokeThickness="1.7"/>
            <Rectangle Canvas.Left="5" Canvas.Top="6" Width="12" Height="7" Stroke="Black" StrokeThickness="1.7" Fill="Transparent"/>
            <Line StartPoint="11,13" EndPoint="11,19" Stroke="Black" StrokeThickness="1.7"/>
          </Canvas>
        </Button>
      </WrapPanel>

      <!-- Ряд подкатегорий -->
      <Border x:Name="SubcategoryRow" Grid.Row="1" IsVisible="False"
              Background="#F1F5F9" CornerRadius="8"
              Padding="6,5" Margin="0,2,0,2">
        <WrapPanel x:Name="SubcategoryPanel"/>
      </Border>

      <!-- Выпадающий ряд элементов палитры -->
       <Border x:Name="PaletteRow" Grid.Row="2" IsVisible="False"
              Background="#F1F5F9" CornerRadius="8"
              Padding="6,5" Margin="0,2,0,2">
        <Grid ColumnDefinitions="Auto,*">
          <Button x:Name="BackToSubcategoriesButton"
                  Grid.Column="0"
                  Classes="pal"
                  Content="‹"
                  Click="BackToSubcategories_Click"
                  Width="26" Padding="0"
                  Margin="0,0,6,4"
                  FontSize="15" FontWeight="Bold"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  VerticalAlignment="Stretch"/>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="94">
            <WrapPanel x:Name="PalettePanel"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Border>

  <!-- 2. ПАНЕЛЬ ВКЛАДОК (под инструментами, прямо над холстом) -->
  <Border x:Name="TabsBarBorder"
          Grid.Row="2"
          Background="#F8FAFC"
          BorderBrush="#E2E8F0"
          BorderThickness="0,0,0,1"
          Padding="8,3,8,0">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
        <StackPanel x:Name="TabsPanel"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    Spacing="4"/>
        <Button x:Name="NewTabButton"
                Content="+"
                Click="New_Click"
                Width="24" Height="24" Padding="0"
                Margin="2,0,0,2"
                CornerRadius="5"
                Background="Transparent" Foreground="#64748B"
                BorderThickness="0"
                FontSize="15" FontWeight="SemiBold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Новая вкладка"/>
      </StackPanel>
    </ScrollViewer>
  </Border>

  <!-- 3. РАБОЧАЯ ОБЛАСТЬ (ТУЛБАР СЛЕВА + ХОЛСТ) -->
  <Grid Grid.Row="3" ColumnDefinitions="Auto,*">
   <Border x:Name="LeftToolbarBorder"
           Grid.Column="0"
           Margin="10,10,0,10"
           Padding="4,6"
           CornerRadius="7"
           Background="White"
           BorderBrush="#D6DEE9"
           BorderThickness="1"
           VerticalAlignment="Top">
    <StackPanel Orientation="Vertical" Spacing="4">
     <Button x:Name="UndoToolbarButton" Classes="tool" Content="↶" FontSize="15" Click="UndoToolbar_Click" ToolTip.Tip="Отменить (Ctrl+Z)"/>
     <Button x:Name="RotateToolbarButton" Classes="tool" Content="↻" FontSize="15" Click="RotateToolbar_Click" ToolTip.Tip="Повернуть (R)"/>
     <Button x:Name="DeleteToolbarButton" Classes="tool" Content="✕" FontSize="13" Click="DeleteToolbar_Click" ToolTip.Tip="Удалить (Del)"/>
     <Button x:Name="WireColorToolbarButton" Classes="tool" Click="WireColorToolbar_Click" ToolTip.Tip="Цвет провода">
      <Ellipse x:Name="WireColorDot" Width="13" Height="13" Fill="#8B4513" Stroke="#94A3B8" StrokeThickness="1"/>
     </Button>
    </StackPanel>
   </Border>

   <Border x:Name="ViewportBorder" Grid.Column="1" Margin="8,10,10,10" BorderBrush="#D6DEE9" BorderThickness="1" CornerRadius="7" Background="White" ClipToBounds="True">
    <Grid x:Name="Viewport" Background="White" ClipToBounds="True">
     <Canvas>
      <Canvas x:Name="SchematicCanvas" Canvas.Left="0" Canvas.Top="0" Width="3000" Height="2000" Background="White"
        Focusable="True"
        PointerPressed="Canvas_PointerPressed"
        PointerMoved="Canvas_PointerMoved"
        PointerReleased="Canvas_PointerReleased"
        PointerExited="Canvas_PointerExited"
        KeyDown="Canvas_KeyDown"/>
     </Canvas>
    <Border x:Name="WorkAreaBadge" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="8,5" CornerRadius="4" Background="#F1F5F9" IsHitTestVisible="False">
      <TextBlock x:Name="WorkAreaLabel" Text="РАБОЧЕЕ ПОЛЕ" FontSize="10" Foreground="#64748B"/>
     </Border>
    </Grid>
   </Border>
  </Grid>

  <!-- 4. СТАТУС-БАР -->
  <Border x:Name="StatusBar" Grid.Row="4" Background="White" BorderBrush="#D9E1EC" BorderThickness="0,1,0,0" Padding="10,3">
   <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
    <TextBlock Grid.Column="0" x:Name="StatusText" Margin="0,0,12,0" Text="" Foreground="#64748B" FontSize="10" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" x:Name="CursorCoordsText" Text="X: 0  Y: 0" Foreground="#94A3B8" FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" x:Name="ZoomStatusText" Text="100%" Foreground="#94A3B8" FontSize="10" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="0,0,14,0" VerticalAlignment="Center">
      <Ellipse x:Name="SimIndicatorDot" Width="7" Height="7" Fill="#94A3B8" VerticalAlignment="Center"/>
      <TextBlock x:Name="SimIndicatorText" Text="Стоп" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Grid.Column="4" Text="MVP 0.5.0" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>